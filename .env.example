# --- required on Vercel (Settings → Environment Variables) ---
# Any long random text (e.g. run: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@formfirst.com
# Local default below. Use a strong password on Vercel.
ADMIN_PASSWORD=admin123
# DATABASE_URL is added automatically when you connect a Neon Postgres database in Vercel.
# Leave it empty locally: the app uses an embedded Postgres in ./data/pglite.
DATABASE_URL=

# --- the AI (optional but recommended) ---
# Get a key at https://console.anthropic.com. Without it the app runs in "basic mode":
# templated replies and a rule-based summary, so everything still works.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- optional ---
BUSINESS_NAME=FormFirst
PORT=4000
# Max new leads one form accepts per 24h (spam/cost guard)
MAX_LEADS_PER_FORM_PER_DAY=200
# Local: demo user (demo@formfirst.com / demo123) with sample leads is created unless SEED_DEMO=0.
# Vercel: no demo user unless SEED_DEMO=1.
SEED_DEMO=1
# Email the business owner when a lead summary is ready (https://resend.com)
RESEND_API_KEY=
RESEND_FROM=FormFirst <onboarding@resend.dev>
